<%- include('../partials/header', { title: title, loadChoicesCss: typeof loadChoicesCss !== 'undefined' && loadChoicesCss }) %>
<% var dsTitle = doctor ? 'Редактирование врача' : 'Добавить врача'; var dsSubtitle = doctor ? ('Пользователь #' + doctor.id + (typeof doctor.profile_id !== 'undefined' && doctor.profile_id != null ? ', профиль #' + doctor.profile_id : '')) : 'Создание учётной записи и профиля врача'; var dsIcon = 'bi-person-badge'; var dsBackHref = '/admin/doctors'; var dsBackLabel = 'К списку врачей'; %>
<%- include('../partials/ds-page-header') %>

<div class="app-card app-narrow-card app-card--static">
  <div class="p-4 p-md-5">

    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success alert-dismissible fade show"><%= success %><button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <% if (doctor) { %>
      <%- include('../partials/profile-avatar-panel', {
        avatarPerson: doctor,
        panelTitle: 'Фото врача',
        uploadUrl: '/admin/doctors/' + doctor.id + '/avatar',
        removeUrl: '/admin/doctors/' + doctor.id + '/avatar/remove',
        idPrefix: 'adminDoctorAvatar',
        panelHint: 'Нажмите на фото или кнопку — файл загрузится автоматически.',
        showRemove: !!doctor.avatar_path
      }) %>
    <% } %>

    <% const chosen = typeof doctorSpecIds !== 'undefined' && doctorSpecIds ? doctorSpecIds : []; %>
    <% const prim = typeof primarySpecId !== 'undefined' ? primarySpecId : null; %>
    <script type="application/json" id="admin-spec-choices-config"><%- JSON.stringify({
      meta: specializations.map(function (s) {
        return { id: s.id, name: s.name, g: s.compat_group || 'therapy' };
      }),
      initialIds: chosen,
      initialPrimary: prim != null ? String(prim) : ''
    }) %></script>

    <form
      method="POST"
      action="<%= doctor ? '/admin/doctors/' + doctor.id + '/edit' : '/admin/doctors' %>"
      data-no-validation-success="1"
      id="adminDoctorMainForm"
      <% if (!doctor) { %>enctype="multipart/form-data"<% } %>
    >
      <%- include('../partials/csrf') %>
    <% if (doctor) { %>
      <input type="hidden" name="user_id" value="<%= doctor.id %>">
    <% } else { %>
      <%- include('../partials/admin-doctor-avatar-panel', {
        avatarPerson: { first_name: '', last_name: '', id: 'new', email: '' },
        avatarMode: 'create'
      }) %>
    <% } %>

      <div class="row g-3 mb-3">
        <div class="col-md-6">
          <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
          <input type="email" class="form-control" name="email" value="<%= doctor ? doctor.email || '' : '' %>" required>
        </div>
        <% if (!doctor) { %>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Пароль <span class="text-danger">*</span></label>
            <input type="password" class="form-control" name="password" required minlength="6">
          </div>
        <% } else { %>
          <div class="col-md-6">
            <label class="form-label fw-semibold">Новый пароль</label>
            <input type="password" class="form-control" name="new_password" autocomplete="new-password" placeholder="Оставьте пустым, чтобы не менять" title="Если задаёте пароль — не менее 6 символов (проверка на сервере)">
            <div class="form-text">Если поле пустое, пароль не изменится.</div>
          </div>
        <% } %>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-md-4">
          <label class="form-label fw-semibold">Фамилия <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="last_name" value="<%= doctor ? doctor.last_name : '' %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-semibold">Имя <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="first_name" value="<%= doctor ? doctor.first_name : '' %>" required>
        </div>
        <div class="col-md-4">
          <label class="form-label fw-semibold">Отчество</label>
          <input type="text" class="form-control" name="middle_name" value="<%= doctor ? doctor.middle_name || '' : '' %>">
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-12 admin-doctor-phone-field">
          <%- include('../partials/phone-international-field', {
            phoneFieldId: 'admin_doctor_phone',
            phoneValue: doctor ? doctor.phone : '',
            phoneRequired: true,
            phoneBlockClass: 'mb-0 admin-phone-intl-wrap'
          }) %>
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-12 admin-spec-field">
          <label class="form-label fw-semibold" for="admin-spec-multi">Специализации <span class="text-danger">*</span></label>
          <div id="spec-field-error" class="invalid-feedback admin-spec-error d-none" role="alert"></div>
          <select
            id="admin-spec-multi"
            class="form-select choices-spec-multi"
            name="specialization_ids[]"
            multiple
            required
            aria-describedby="spec-field-error specCompatCompact"
          >
            <% specializations.forEach(function (s) { %>
              <option value="<%= s.id %>" <%= chosen.indexOf(s.id) !== -1 ? 'selected' : '' %>><%= s.name %></option>
            <% }) %>
          </select>

          <label class="form-label fw-semibold mt-3 mb-2" for="admin-spec-primary">Основная специализация</label>
          <select id="admin-spec-primary" class="form-select choices-spec-primary" name="primary_specialization_id" aria-label="Основная специализация">
            <option value="">— Не выбрано —</option>
            <% specializations.forEach(function (s) { %>
              <% if (chosen.indexOf(s.id) !== -1) { %>
                <option value="<%= s.id %>" <%= prim == s.id ? 'selected' : '' %>><%= s.name %></option>
              <% } %>
            <% }) %>
          </select>
          <p class="small mb-0 mt-2 d-none admin-spec-hint text-muted" id="specCompatCompact"></p>
        </div>
      </div>

      <div class="row g-3 mb-3 align-items-end">
        <div class="col-sm-6 col-md-4 col-lg-3">
          <label class="form-label fw-semibold mb-1">Кабинет</label>
          <div class="input-group admin-doctor-cabinet-input">
            <span class="input-group-text" aria-hidden="true"><i class="bi bi-door-open"></i></span>
            <input type="text" class="form-control" name="cabinet" value="<%= doctor ? doctor.cabinet || '' : '' %>" placeholder="№" inputmode="numeric" autocomplete="off">
          </div>
        </div>
        <% if (doctor) { %>
          <div class="col-sm-6 col-md-4 col-lg-3">
            <label class="form-label fw-semibold mb-1">Статус</label>
            <select class="form-select" name="is_blocked">
              <option value="false" <%= !doctor.is_blocked ? 'selected' : '' %>>Активен</option>
              <option value="true" <%= doctor.is_blocked ? 'selected' : '' %>>Заблокирован</option>
            </select>
          </div>
        <% } %>
      </div>

      <% if (!doctor) { %>
      <script type="application/json" id="admin-work-history-initial">[]</script>
      <div class="mb-4 admin-work-history-panel" id="adminWorkHistoryRoot">
        <div class="admin-work-history-toolbar d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
          <div class="d-flex flex-wrap align-items-end gap-3">
            <h2 class="h6 fw-bold mb-0">История работы</h2>
            <div class="admin-work-history-experience">
              <label class="form-label small fw-semibold mb-1" for="calculatedExperienceYears">Стаж (лет)</label>
              <input
                type="number"
                class="form-control form-control-sm"
                id="calculatedExperienceYears"
                min="0"
                value="0"
                readonly
                tabindex="-1"
                aria-readonly="true"
                title="Считается по периодам работы"
              />
            </div>
          </div>
          <button type="button" class="btn btn-outline-primary btn-sm rounded-pill" id="workHistoryAddBtn">
            <i class="bi bi-plus-lg me-1"></i>Добавить период
          </button>
        </div>
        <div id="workHistoryRows" class="admin-work-history-stack"></div>
        <input type="hidden" name="work_history_json" id="workHistoryJson" value="[]" />
      </div>
      <% } else { %>
      <% const _workHistoryView = typeof workHistory !== 'undefined' && workHistory ? workHistory : []; %>
      <div class="mb-4 admin-work-history-panel admin-work-history-panel--readonly">
        <div class="admin-work-history-toolbar d-flex flex-wrap justify-content-between align-items-end gap-3 mb-3">
          <h2 class="h6 fw-bold mb-0">История работы</h2>
          <div class="admin-work-history-experience">
            <label class="form-label small fw-semibold mb-1" for="calculatedExperienceYears">Стаж (лет)</label>
            <input
              type="number"
              class="form-control form-control-sm"
              id="calculatedExperienceYears"
              min="0"
              value="<%= doctor.experience_years || 0 %>"
              readonly
              tabindex="-1"
              aria-readonly="true"
            />
          </div>
        </div>
        <% if (_workHistoryView.length) { %>
        <ul class="list-group list-group-flush border rounded-3 mb-0">
          <% _workHistoryView.forEach(function (w) { %>
            <li class="list-group-item px-3 py-2">
              <div class="fw-semibold"><%= w.organization_name %></div>
              <div class="small text-muted"><%= w.period_label %> · <%= w.duration_label %></div>
            </li>
          <% }) %>
        </ul>
        <% } else { %>
        <p class="small text-muted mb-0">Периоды работы не указаны.</p>
        <% } %>
      </div>
      <% } %>

      <div class="mb-3">
        <label class="form-label fw-semibold">Образование</label>
        <textarea class="form-control" name="education" rows="2"><%= doctor ? doctor.education || '' : '' %></textarea>
      </div>

      <div class="mb-4">
        <label class="form-label fw-semibold">Описание</label>
        <textarea class="form-control" name="description" rows="3"><%= doctor ? doctor.description || '' : '' %></textarea>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-lg me-1"></i><%= doctor ? 'Сохранить изменения' : 'Добавить врача' %></button>
        <a href="/admin/doctors" class="btn btn-outline-secondary">Отмена</a>
      </div>
    </form>
  </div>
</div>

<script src="/js/phone-international.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var hint = document.getElementById('adminDoctorAvatarHint');
  if (hint && typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
    new bootstrap.Tooltip(hint, { container: 'body' });
  }
  var file = document.getElementById('adminDoctorAvatarFile');
  var btn = document.getElementById('adminDoctorAvatarChangeBtn');
  var hit = document.getElementById('adminDoctorAvatarChangeTrigger');
  function pick() {
    if (file) file.click();
  }
  if (btn && file) btn.addEventListener('click', pick);
  if (hit && file) {
    hit.addEventListener('click', function (e) {
      e.preventDefault();
      pick();
    });
  }
  if (!file || !document.querySelector('.admin-doctor-avatar-create-preview')) return;
  file.addEventListener('change', function () {
    var f = file.files && file.files[0];
    var holder = document.querySelector('#adminDoctorAvatarHolder .user-avatar');
    if (!f || !holder) return;
    if (!/^image\/(jpeg|png|webp)$/.test(f.type) || f.size > 2 * 1024 * 1024) return;
    var url = URL.createObjectURL(f);
    var img = holder.querySelector('.user-avatar__img');
    if (!img) {
      holder.classList.add('user-avatar--has-img');
      holder.style.background = '';
      var ini = holder.querySelector('.user-avatar__initials');
      if (ini) ini.remove();
      img = document.createElement('img');
      img.className = 'user-avatar__img';
      img.alt = '';
      holder.appendChild(img);
    }
    img.onload = function () { URL.revokeObjectURL(url); };
    img.src = url;
  });
  ['last_name', 'first_name'].forEach(function (name) {
    var inp = document.querySelector('input[name="' + name + '"]');
    if (!inp) return;
    inp.addEventListener('input', function () {
      var holder = document.querySelector('#adminDoctorAvatarHolder .user-avatar');
      if (!holder || holder.querySelector('.user-avatar__img')) return;
      var L = (document.querySelector('input[name="last_name"]') || {}).value || '';
      var F = (document.querySelector('input[name="first_name"]') || {}).value || '';
      var ini = '';
      if (L.trim()) ini += L.trim().charAt(0).toUpperCase();
      if (F.trim()) ini += F.trim().charAt(0).toUpperCase();
      var el = holder.querySelector('.user-avatar__initials');
      if (el) el.textContent = ini || '?';
    });
  });
});
</script>
<%- include('../partials/footer') %>
<% if (doctor) { %><script src="/js/profile-avatar-auto.js"></script><% } %>
<% if (!doctor) { %>
<script src="/js/admin-doctor-work-history.js"></script>
<% } %>
