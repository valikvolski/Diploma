<%
  var _p = typeof p !== 'undefined' && p ? p : { currentPage: 1, totalPages: 1, hasPrev: false, hasNext: false };
  var _label = typeof ariaLabel !== 'undefined' && ariaLabel ? ariaLabel : 'Пагинация';
  var _pageUrl = typeof pageUrl === 'function' ? pageUrl : function (n) { return '#'; };
  var _compact = typeof compact !== 'undefined' && compact;
  var _pageParam = typeof pageParam !== 'undefined' && pageParam ? pageParam : 'page';
  var _basePath = typeof basePath !== 'undefined' && basePath ? basePath : '';
  var _cur = _p.currentPage || 1;
  var _total = _p.totalPages || 1;
  function _items(cur, total) {
    var out = [];
    if (total <= 1) return out;
    if (total <= 7) {
      for (var i = 1; i <= total; i++) out.push(i);
      return out;
    }
    out.push(1);
    var start = Math.max(2, cur - 1);
    var end = Math.min(total - 1, cur + 1);
    if (start > 2) out.push('ellipsis-start');
    for (var pg = start; pg <= end; pg++) out.push(pg);
    if (end < total - 1) out.push('ellipsis-end');
    out.push(total);
    return out;
  }
  var _pages = _items(_cur, _total);
  var _jumpHref = _basePath ? '' : _pageUrl(1);
%>
<% if (_total > 1) { %>
  <div class="admin-pagination-wrap<%= _compact ? ' admin-pagination-wrap--compact' : '' %> d-flex align-items-center justify-content-between flex-wrap gap-2 mt-3">
    <div class="admin-pagination-meta small text-muted mb-0">Страница <%= _cur %> из <%= _total %></div>
    <nav
      aria-label="<%= _label %>"
      data-admin-pagination
      data-max-pages="<%= _total %>"
      data-page-param="<%= _pageParam %>"
      <% if (_basePath) { %>data-base-path="<%= _basePath %>"<% } %>
      <% if (_jumpHref) { %>data-jump-href="<%= _jumpHref %>"<% } %>
    >
      <ul class="pagination pagination-sm mb-0 admin-pagination-list">
        <li class="page-item <%= _p.hasPrev ? '' : 'disabled' %>">
          <% if (_p.hasPrev) { %>
            <a class="page-link" href="<%= _pageUrl(_cur - 1) %>" aria-label="Предыдущая страница"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
          <% } else { %>
            <span class="page-link" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
          <% } %>
        </li>
        <% _pages.forEach(function (it) { %>
          <% if (it === 'ellipsis-start' || it === 'ellipsis-end') { %>
            <li class="page-item admin-pagination-ellipsis">
              <button
                type="button"
                class="page-link js-admin-pagination-ellipsis"
                aria-label="Перейти на страницу"
                title="Перейти на страницу"
              >…</button>
            </li>
          <% } else { %>
            <li class="page-item <%= it === _cur ? 'active' : '' %>">
              <% if (it === _cur) { %>
                <span class="page-link" aria-current="page"><%= it %></span>
              <% } else { %>
                <a class="page-link" href="<%= _pageUrl(it) %>"><%= it %></a>
              <% } %>
            </li>
          <% } %>
        <% }) %>
        <li class="page-item <%= _p.hasNext ? '' : 'disabled' %>">
          <% if (_p.hasNext) { %>
            <a class="page-link" href="<%= _pageUrl(_cur + 1) %>" aria-label="Следующая страница"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
          <% } else { %>
            <span class="page-link" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
          <% } %>
        </li>
      </ul>
    </nav>
  </div>
<% } %>
